root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts,ktm}]
indent_style = space
indent_size = 4

[*.{xml,json,yml,yaml,toml,properties,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[gradlew]
end_of_line = lf

[*.png]
insert_final_newline = false
